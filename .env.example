CHILD_NAME=YourKidsName
CHILD_PASSWORD=change-me

# Pick a preset: boy, girl, or neutral.
THEME=neutral

# Optional: host port to serve on (default 8100). Change if it's already
# taken, or if running more than one instance on the same host.
# PORT=8100

# Optional: override just one piece of the preset (leave commented to use
# THEME's defaults). Any set here wins regardless of THEME.
# THEME_EMOJI="🌸"
# THEME_BG="linear-gradient(135deg, #ff9de2 0%, #ffcf77 50%, #a0f0ed 100%)"
# THEME_ACCENT="#d63384"
